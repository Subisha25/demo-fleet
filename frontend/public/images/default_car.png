<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 160" width="100%" height="100%">
  <defs>
    <linearGradient id="carGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5" />
      <stop offset="100%" stop-color="#312E81" />
    </linearGradient>
    <linearGradient id="bodyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#F3F4F6" />
      <stop offset="100%" stop-color="#E5E7EB" />
    </linearGradient>
  </defs>
  <rect width="240" height="160" rx="16" fill="#F8FAFC" />
  <!-- Shadow -->
  <ellipse cx="120" cy="132" rx="76" ry="8" fill="#E2E8F0" opacity="0.8" />
  <!-- Car Body Bottom -->
  <path d="M40 100 L44 88 C46 84 50 82 55 82 L70 82 L88 64 C92 60 98 58 104 58 L146 58 C152 58 158 60 162 64 L180 82 L192 82 C197 82 201 85 203 90 L208 102 C210 106 207 110 203 110 L188 110 C186 100 178 92 168 92 C158 92 150 100 148 110 L102 110 C100 100 92 92 82 92 C72 92 64 100 62 110 L44 110 C41 110 39 106 40 100 Z" fill="url(#carGrad)" />
  <!-- Windshield and Windows -->
  <path d="M92 80 L105 64 L138 64 L138 80 Z" fill="#93C5FD" opacity="0.8" />
  <path d="M144 80 L144 64 L158 64 L172 80 Z" fill="#BFDBFE" opacity="0.8" />
  <!-- Wheels -->
  <circle cx="82" cy="110" r="16" fill="#1E293B" />
  <circle cx="82" cy="110" r="8" fill="#94A3B8" />
  <circle cx="168" cy="110" r="16" fill="#1E293B" />
  <circle cx="168" cy="110" r="8" fill="#94A3B8" />
